{
  "name": "smart-planter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bundle exec rake build",
    "generate:bindings": "bundle exec rake build",
    "db:local": "wrangler d1 execute smart-planter --local --file schema.sql && wrangler d1 execute smart-planter --local --file seed.sql",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "jsonc-parser": "3.2.0",
    "wrangler": "4.125.0"
  }
}
